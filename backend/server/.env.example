PORT=3001
NODE_ENV=development

# Local development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pmp_app
DB_USER=postgres
DB_PASSWORD=postgres

# Railway / production: prefer DATABASE_URL over the DB_* fields above.
# DATABASE_URL=postgresql://user:password@host:5432/pmp_app
# DATABASE_SSL=true

JWT_SECRET=replace_with_a_long_random_value_at_least_32_chars
ALLOWED_ORIGINS=*

# Exact Authorization header configured for the RevenueCat webhook.
REVENUECAT_WEBHOOK_SECRET=replace_with_a_long_random_value
